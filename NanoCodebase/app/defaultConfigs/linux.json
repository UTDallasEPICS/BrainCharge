{
  "language": "en",

  "audio": {
    "input_device": "",

    "whisper": {
      "binary":"whisper.cpp/whisper-bin-ubuntu-arm64/whisper-cli",
      "model": "whisper.cpp/ggml-base.bin"
    },

    "interrupt": {
      "minimum_words": 2,
      "warmup_seconds": 0.4,
      "echo_similarity_threshold": 0.55
    }
  },

  "webapp": {
    "enabled": true,
    "url": "http://127.0.0.1:3001/api/nano/event",
    "inbox_url": "http://127.0.0.1:3001/api/nano/inbox",
    "settings_url": "http://127.0.0.1:3001/api/settings",
    "token": "change-me",
    "poll_interval_s": 2.0
  }
}