{
  "language": "en",

  "audio": {
    "input_device": "",

    "whisper": {
      "binary":"whisper.cpp/whisper-bin-ubuntu-arm64/whisper-cli",
      "model": "whisper.cpp/ggml-base.bin"
    },

    "interrupt": {
      "minimum_words": 2,
      "warmup_seconds": 0.4,
      "echo_similarity_threshold": 0.55
    }
  },

  "vision": {
    "camera": {
      "resolution_width": 1280,
      "resolution_height": 720,
      "capture_delay": 100
    },

    "emotion_classification": {
      "frames_per_second": 10,
      "top_emotions": 3,
      "emotions_confidence_threshold": 0.1
    }
  },

  "webapp": {
    "enabled": true,
    "url": "http://127.0.0.1:3001/api/nano/event",
    "token": "change-me"
  }
}