# Port for the calendar API server
PORT=3001

# Path to your GCP service account JSON key (keep this file out of git)
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json

# Calendar ID from Google Calendar → Settings → your calendar → Integrate calendar
# Can be your Gmail address OR the long ID ending in @group.calendar.google.com
GOOGLE_CALENDAR_ID=your.email@gmail.com

# IANA timezone for event times (optional, defaults to America/Chicago)
CALENDAR_TIMEZONE=America/Chicago

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
# For running the app and auth setup on IOS - uncomment these below
#BETTER_AUTH_URL=http://192.168.1.42:5173
#CLIENT_ORIGIN=http://192.168.1.42:5173